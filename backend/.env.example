# Copy to .env and adjust for your environment.
PORT=4000
# CORS_ORIGINS=https://example.com
# SITE_URL=https://example.com
# RATE_LIMIT=120
# Login/register attempts allowed per IP per 5 minutes. Optional, defaults to 20.
# AUTH_RATE_LIMIT=20
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
PASSWORD_RESET_TTL_MINUTES=30
# Admin login credentials used by the admin panel (/admin).
# Defaults shown below are used when unset — change these in production.
# ADMIN_EMAIL=pratistha.sapkota123@gmail.com
# ADMIN_PASSWORD=admin123