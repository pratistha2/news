# Copy to .env and adjust for your environment.
PORT=4000
# Comma-separated allowed browser origins. In production an empty value blocks
# all cross-origin browser requests; in development it allows only localhost:3000.
# CORS_ORIGINS=https://example.com
# SITE_URL=https://example.com
# Set only if you run behind a reverse proxy (number of hops).
# TRUST_PROXY=1
# RATE_LIMIT=120
# INTERNAL_RATE_LIMIT=6000
# Shared secret with the frontend so server-side renders do not share the public
# per-IP rate-limit bucket. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# INTERNAL_API_TOKEN=
# Login/register attempts allowed per IP per 5 minutes. Optional, defaults to 20.
# AUTH_RATE_LIMIT=20
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
PASSWORD_RESET_TTL_MINUTES=30

# Admin panel credentials. No defaults exist on purpose: with these unset,
# POST /api/admin/login returns 503 and the panel is locked.
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=
# ADMIN_PASSWORD_HASH=

# Optional admin session and brute-force tuning.
# ADMIN_SESSION_TTL_MINUTES=720
# ADMIN_MAX_FAILURES=5
# ADMIN_LOCKOUT_MINUTES=15
# ADMIN_MAX_ATTEMPTS_PER_IP=20
