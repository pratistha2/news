# ===== Runtime configuration =====
# Root `npm run dev` starts the API (:4000) and the web app (:3000) together.

# --- Backend API (backend/.env) ---
# Port the API listens on. Optional, defaults to 4000 when unset.
# PORT=4000

# Comma-separated list of allowed browser origins for CORS.
# Leave empty in development to allow any origin.
# For production, list your site origin(s), e.g.:
# CORS_ORIGINS=https://hamrosamachar.com
# SITE_URL=https://hamrosamachar.com

# Max requests per minute per client IP. Optional, defaults to 120.
# RATE_LIMIT=120

# Login/register attempts allowed per IP per 5 minutes. Optional, defaults to 20.
# AUTH_RATE_LIMIT=20

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
PASSWORD_RESET_TTL_MINUTES=3

# Email and password used by the admin panel (/admin) to manage the site.
# Defaults: pratistha.sapkota123@gmail.com / admin123 when unset. Set strong values in production.
# ADMIN_EMAIL=pratistha.sapkota123@gmail.com
# ADMIN_PASSWORD=admin123

# --- Frontend (frontend/.env or frontend/.env.local) ---
# Base URL of the news API. Optional, defaults to http://localhost:4000.
# NEXT_PUBLIC_API_URL=https://api.example.com

# Canonical site URL used in metadata / sitemap (produces /sitemap.xml).
NEXT_PUBLIC_SITE_URL=http://localhost:3000