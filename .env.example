# ===== Runtime configuration =====
# Root `npm run dev` starts the API (:4000) and the web app (:3000) together.

# --- Backend API (backend/.env) ---
# Port the API listens on. Optional, defaults to 4000 when unset.
# PORT=4000

# Comma-separated list of allowed browser origins for CORS.
# Leave empty to allow only http://localhost:3000 in development.
# In production an empty value REJECTS every cross-origin browser request, so
# you must list your site origin(s) explicitly:
# CORS_ORIGINS=https://hamrosamachar.com
# SITE_URL=https://hamrosamachar.com

# Number of reverse proxies in front of the API (e.g. 1 for a single nginx
# hop). Only set this if you actually run behind a proxy: it makes the API
# trust X-Forwarded-For, which is spoofable if misconfigured.
# TRUST_PROXY=1

# Shared secret that lets the Next.js server fetch the API without spending the
# public per-IP rate-limit budget. Every server-side page render otherwise
# shares one bucket and throttles the whole site. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Set the same value here and in frontend/.env.local. Leaving it unset disables
# the bypass entirely (safe, just more prone to throttling).
# INTERNAL_API_TOKEN=

# Max requests per minute per client IP. Optional, defaults to 120.
# RATE_LIMIT=120
# Budget per IP for requests carrying a valid INTERNAL_API_TOKEN. Defaults to 6000.
# INTERNAL_RATE_LIMIT=6000

# Login/register attempts allowed per IP per 5 minutes. Optional, defaults to 20.
# AUTH_RATE_LIMIT=20

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# How long a password-reset link stays valid, in minutes (5-120). Defaults to 30.
PASSWORD_RESET_TTL_MINUTES=30

# ===== Admin panel (/admin) =====
# There are NO default admin credentials. If ADMIN_EMAIL and a secret are both
# unset, POST /api/admin/login returns 503 and the panel is unreachable.
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=
# Use at least 16 characters. The value is hashed with scrypt at boot and the
# plaintext is never compared or stored.
# To keep the plaintext out of the environment entirely, generate a hash and
# use ADMIN_PASSWORD_HASH instead (takes precedence over ADMIN_PASSWORD):
#   node -e "const c=require('crypto'),s=c.randomBytes(16).toString('hex');c.scrypt(process.argv[1],s,64,(e,k)=>console.log(s+':'+k.toString('hex')))" 'your-password'
# ADMIN_PASSWORD_HASH=

# Optional admin session and brute-force tuning.
# ADMIN_SESSION_TTL_MINUTES=720
# ADMIN_MAX_FAILURES=5
# ADMIN_LOCKOUT_MINUTES=15
# ADMIN_MAX_ATTEMPTS_PER_IP=20

# --- Frontend (frontend/.env or frontend/.env.local) ---
# Base URL of the news API. Optional, defaults to http://localhost:4000.
# NEXT_PUBLIC_API_URL=https://api.example.com

# Shared secret with the backend, read server-side only. Never prefix this
# with NEXT_PUBLIC_ or it would be exposed to the browser.
# INTERNAL_API_TOKEN=

# Canonical site URL used in metadata / sitemap (produces /sitemap.xml).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
